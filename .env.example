# Liar Liar — environment variables
# EVERYTHING here is OPTIONAL. With no env vars the app runs in guest mode:
# local dev serves the web app on :3000 and the wrangler worker on :1999, history is stored
# locally in the browser, and sign-in is hidden. Copy to .env.local to enable more.

# --- Realtime (Cloudflare Workers / partyserver) ---------------------------
# Host of the realtime worker the browser connects to.
# Local dev default is localhost:1999. In prod use your deployed host, e.g.
# liarliar.<your-subdomain>.workers.dev
NEXT_PUBLIC_PARTYKIT_HOST=localhost:1999

# Public URL of THIS Next.js app. The party server POSTs finished games to
# `${NEXT_PUBLIC_APP_URL}/api/games`. Set on Vercel to your deployment URL and,
# on the worker via `wrangler.jsonc` vars or `npx wrangler secret put NEXT_PUBLIC_APP_URL`.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret authenticating the party server -> /api/games POST. Generate a
# long random value. Set it in BOTH Vercel and the worker
# (`npx wrangler secret put PARTY_SECRET`). Leave unset to disable cloud game saving.
PARTY_SECRET=

# --- Database (Neon / any Postgres) ---------------------------------------
# Postgres connection string. Use the Neon POOLED connection string (host with
# `-pooler`) since we run with prepare:false / pgbouncer. Leave unset to disable
# all cloud persistence (API routes then return 503 { reason: "db_disabled" }).
# Example (placeholder — replace all parts):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
#
# LOCAL DEV (no Docker): run `npm run db:local` to start an embedded PGlite
# Postgres on 127.0.0.1:5432 (fallback 54329); it prints a ready-to-use
# DATABASE_URL. `npm run dev:full` wires that URL into `next dev` for you.
DATABASE_URL=

# --- Auth (Clerk) — OPTIONAL ----------------------------------------------
# Set BOTH keys to enable sign-in (cloud profile + claimable play history).
# Get them from the Clerk dashboard. If either is missing, auth stays disabled.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk's sign-in / sign-up UI lives (matches the app's route folders).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where Clerk sends users after signing in / up when there is no redirect target.
# `/play` lands them straight back in the game.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/play
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/play
