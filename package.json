{
  "name": "liarliar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,party -c blue,magenta \"next dev\" \"partykit dev\"",
    "dev:web": "next dev",
    "dev:party": "partykit dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p party/tsconfig.json",
    "party:deploy": "partykit deploy",
    "db:local": "node scripts/dev-db.mjs",
    "dev:full": "concurrently -n db,web,party -c green,blue,magenta \"node scripts/dev-db.mjs\" \"DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres next dev\" \"partykit dev\"",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.7",
    "canvas-confetti": "1.9.4",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.48.0",
    "motion": "13.4.4",
    "nanoid": "5.1.16",
    "next": "15.5.26",
    "partysocket": "1.3.0",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "^20",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "9.2.4",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "partykit": "0.0.115",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.9"
  }
}
